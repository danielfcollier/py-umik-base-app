# =============================================================================
# audio-tools — Environment Configuration
# Copy this file to .env and fill in values for your setup.
# Variables marked "(optional)" have sensible defaults and can be left unset.
# =============================================================================


# =============================================================================
# Calibration
# =============================================================================

# Path to your UMIK-1 calibration file (.txt).
# (optional) If unset, falls back to auto-discovery in ~/.config/audio-tools/.
CALIBRATION_FILE=""


# =============================================================================
# Application Settings  (prefix: APP__, nested with __)
# All values shown are the compiled-in defaults.
# Uncomment and change only what you need to override.
# =============================================================================

# --- Audio capture ---
# APP__AUDIO__SAMPLE_RATE=48000           # Hz
# APP__AUDIO__BUFFER_SECONDS=5.0          # initial capture buffer
# APP__AUDIO__MIN_BUFFER_SECONDS=3.0      # minimum allowed buffer
# APP__AUDIO__LUFS_WINDOW_SECONDS=3       # LUFS measurement window (seconds)
# APP__AUDIO__NUM_TAPS=1024               # FIR filter taps for calibration
# APP__AUDIO__DTYPE=float32               # sample format
# APP__AUDIO__HIGH_PRIORITY=false         # request OS real-time scheduling

# --- Metrics output ---
# APP__METRICS__INTERVAL_SECONDS=3        # emit interval in seconds
# APP__METRICS__DBFS_LOWER_BOUND=-120.0
# APP__METRICS__LUFS_LOWER_BOUND=-120.0

# --- Recording ---
# APP__RECORDER__ROTATION_SECONDS=3600    # WAV file rotation interval

# --- Hardware defaults (UMIK-1) ---
# APP__HARDWARE__NOMINAL_SENSITIVITY_DBFS=-18.0
# APP__HARDWARE__REFERENCE_DBSPL=94.0
# APP__HARDWARE__TARGET_DEVICE_NAME=UMIK-1

# --- ZMQ distributed topology ---
# APP__ZMQ__HOST=127.0.0.1
# APP__ZMQ__PORT=5555

# --- Reconnection (listener thread) ---
# APP__RECONNECT_DELAY_SECONDS=5          # seconds between reconnect attempts
# APP__RECONNECT_MAX_RETRIES=             # blank = unlimited


# =============================================================================
# APT Repository Publishing  (make publish-deb / make prune-deb)
# Required only for maintainers building and releasing .deb packages.
# =============================================================================

S3_ACCESS_KEY_ID="your-s3-access-key-id"
S3_SECRET_ACCESS_KEY="your-s3-secret-access-key"
S3_ENDPOINT="https://br-se1.magaluobjects.com"
S3_REGION="br-se1"
S3_PREFIX="audio-tools"

DEB_S3_BUCKET="audio-tools"

# Comma-separated Ubuntu/Debian codenames to publish to (default: jammy,noble,bookworm,trixie).
# bookworm = Raspberry Pi OS 12 (current stable).
# trixie   = Raspberry Pi OS 13 / Debian 13.
# APT_DISTS="jammy,noble,bookworm,trixie"

GPG_KEY_ID="your-gpg-key-fingerprint"
GPG_KEY_FILE="audio-tools.gpg.key"
GPG_PUBKEY_FILE="audio-tools.gpg.pub"
