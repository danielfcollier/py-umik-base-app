# =============================================================================
# S3 / APT Repository Publishing (for make publish-deb)
# =============================================================================
S3_ACCESS_KEY_ID="your-s3-access-key"
S3_SECRET_ACCESS_KEY="your-s3-secret-key"
S3_ENDPOINT="https://<your-s3-endpoint>"
S3_REGION="<region>"
S3_PREFIX="audio-tools"

GPG_KEY_ID="your-gpg-key-fingerprint"
GPG_KEY_FILE="audio-tools.gpg.key"
GPG_PUBKEY_FILE="audio-tools.gpg.pub"

DEB_S3_BUCKET="your-bucket-name"
